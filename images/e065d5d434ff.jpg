  <defs>
    <style>
      .cls-1 {
        stroke-width: .26px;
      }

      .cls-1, .cls-2 {
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .cls-1, .cls-2, .cls-3 {
        fill: none;
        stroke: #000;
      }

      .cls-4, .cls-5, .cls-6, .cls-7 {
        stroke-width: 0px;
      }

      .cls-2, .cls-3 {
        stroke-width: .42px;
      }

      .cls-3 {
