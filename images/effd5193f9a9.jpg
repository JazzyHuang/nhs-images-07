    <style>
      .cls-1, .cls-2 {
        fill: #000;
      }

      .cls-1, .cls-2, .cls-3 {
        stroke-width: 0px;
      }

      .cls-4, .cls-5, .cls-6 {
        stroke: #000;
      }

      .cls-4, .cls-5, .cls-6, .cls-7 {
        fill: none;
      }

      .cls-4, .cls-5, .cls-7 {
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .cls-4, .cls-7 {
        stroke-width: .48px;
      }

      .cls-5, .cls-6 {
        stroke-width: .24px;
      }

      .cls-2 {
        fill-rule: evenodd;
      }

      .cls-6 {
        stroke-miterlimit: 10;
      }

      .cls-3 {
        fill: #989898;
      }

      .cls-7 {
        stroke: #989898;
      }
    </style>
