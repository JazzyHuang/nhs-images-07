  <defs>
    <style>
      .cls-1, .cls-2, .cls-3, .cls-4, .cls-5 {
        fill: none;
        stroke-linecap: round;
      }

      .cls-1, .cls-2, .cls-3, .cls-5 {
        stroke-linejoin: round;
      }

      .cls-1, .cls-4 {
        stroke: #bababa;
        stroke-width: .72px;
      }

      .cls-6, .cls-7 {
        fill: #000;
      }

      .cls-6, .cls-7, .cls-8, .cls-9 {
        stroke-width: 0px;
      }

      .cls-2 {
        stroke-width: .18px;
      }

      .cls-2, .cls-3 {
        stroke: #000;
      }

      .cls-3 {
        stroke-width: .54px;
      }

      .cls-4 {
        stroke-linejoin: bevel;
      }

      .cls-5 {
        stroke: #989898;
        stroke-width: .36px;
      }

      .cls-7 {
        fill-rule: evenodd;
      }

      .cls-8 {
        fill: #989898;
      }

      .cls-9 {
        fill: #fff;
      }
    </style>
