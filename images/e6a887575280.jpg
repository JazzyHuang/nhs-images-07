  <defs>
    <style>
      .cls-1, .cls-2, .cls-3, .cls-4, .cls-5, .cls-6, .cls-7, .cls-8, .cls-9, .cls-10 {
        fill: none;
      }

      .cls-1, .cls-2, .cls-11, .cls-7, .cls-8 {
        stroke-miterlimit: 10;
      }

      .cls-1, .cls-3, .cls-4, .cls-5, .cls-6, .cls-11, .cls-8, .cls-10 {
        stroke-width: .5px;
      }

      .cls-1, .cls-3, .cls-5, .cls-10 {
        stroke: #898989;
      }

      .cls-2 {
        opacity: 0;
      }

      .cls-2, .cls-4, .cls-11, .cls-7, .cls-9 {
        stroke: #000;
      }

      .cls-3, .cls-10 {
        stroke-linecap: round;
      }

      .cls-4, .cls-9 {
        stroke-miterlimit: 500;
      }

      .cls-12 {
        font-family: MabryPro-Medium, 'Mabry Pro';
        font-size: 14px;
        font-weight: 500;
      }

      .cls-6, .cls-8 {
        stroke: #888;
      }

      .cls-11 {
        fill: #fff;
      }

      .cls-7, .cls-9 {
        stroke-width: 1.5px;
      }

      .cls-10 {
        stroke-linejoin: round;
      }
    </style>
  </defs>
